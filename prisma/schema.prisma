generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // NULL la conturile create cu Google (fără parolă)
  passwordHash String?  @map("password_hash")
  name         String?
  referralCode String   @unique @map("referral_code")
  referredById String?  @map("referred_by_id")
  // acceptarea Termenilor la inregistrare
  termsAcceptedAt DateTime? @map("terms_accepted_at")
  termsVersion    String?   @map("terms_version")
  // „Nu vreau emailuri cu noutăți și sfaturi” (Legea 506/2004 art. 12), bifat
  // la înregistrare sau prin dezabonare; momentul alegerii.
  marketingOptOut   Boolean   @default(false) @map("marketing_opt_out")
  marketingChoiceAt DateTime? @map("marketing_choice_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  referredBy User?  @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals  User[] @relation("Referrals")

  constellations SavedConstellation[]
  wallet         Wallet?
  packPurchases  PackPurchase[]
  reportUnlocks  ReportUnlock[]
  emailLogs      EmailLog[]

  @@map("users")
}

model SavedConstellation {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  title         String
  boardConfig   Json     @map("board_config")
  questionnaire Json
  natalChart    Json?    @map("natal_chart")
  teaserText    String?  @map("teaser_text")
  // Prezent = raportul e deblocat. Sursa de adevăr pentru "unlocked", nu un
  // status separat: dacă există conținutul, e deblocat, punct.
  fullReport    Json?    @map("full_report")
  // consimtamantul explicit (art. 9 GDPR) pentru prelucrarea prin AI a datelor constelatiei
  aiConsentAt   DateTime? @map("ai_consent_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportUnlock ReportUnlock?

  @@map("saved_constellations")
}

/**
 * Catalogul pachetelor cumpărabile. Prețul stă aici, nu în cererea
 * clientului: altfel oricine ar putea cumpăra zece credite cu un leu,
 * schimbând suma trimisă către /api/checkout.
 */
model Pack {
  code        String   @id
  name        String
  priceCents  Int      @map("price_cents")
  // Câte deblocări de raport complet aduce pachetul.
  credits     Int
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)

  purchases PackPurchase[]

  @@map("packs")
}

/**
 * Ce are un cont, acum: credite necheltuite. Nu expiră, nu se resetează.
 *
 * Fără plafon de cost separat, spre deosebire de tiparementale: acolo o
 * "ședință" avea cost variabil (până la 25 de replici plus extracții), aici
 * un credit cumpără exact un apel Claude cu preț fix
 * (generateFullReport, o dată per raport) — creditele înseși sunt plafonul.
 */
model Wallet {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  creditsBalance Int      @default(0) @map("credits_balance")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

/**
 * O plată Stripe pentru un pachet. `stripeCheckoutSessionId` e unic, ca
 * același webhook retrimis de Stripe să nu crediteze portofelul de două ori
 * (vezi `creditPurchase` din lib/billing/packs.ts).
 */
model PackPurchase {
  id                      String    @id @default(uuid())
  userId                  String    @map("user_id")
  packCode                String    @map("pack_code")
  stripeCheckoutSessionId String    @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String?   @map("stripe_payment_intent_id")
  amountCents             Int       @map("amount_cents")
  currency                String
  status                  String    @default("pending") // pending | paid
  completedAt             DateTime? @map("completed_at")
  // factura Oblio, emisa automat dupa plata
  invoiceSeries           String?   @map("invoice_series")
  invoiceNumber           String?   @map("invoice_number")
  invoiceUrl              String?   @map("invoice_url")
  invoiceError            String?   @map("invoice_error")
  // acordul pentru furnizarea imediata + pierderea dreptului de retragere (OUG 34/2014 art. 16 lit. a si m)
  consentAt               DateTime? @map("consent_at")
  termsVersion            String?   @map("terms_version")
  createdAt               DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack Pack @relation(fields: [packCode], references: [code])

  @@index([userId, createdAt(sort: Desc)])
  @@map("pack_purchases")
}

/**
 * Cheltuirea unui credit pe o constelație anume. Unic per constelație: o
 * constelație se deblochează o singură dată, nu se plătește de două ori.
 */
model ReportUnlock {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  constellationId String   @unique @map("constellation_id")
  creditsSpent    Int      @default(1) @map("credits_spent")
  unlockedAt      DateTime @default(now()) @map("unlocked_at")

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  constellation SavedConstellation @relation(fields: [constellationId], references: [id], onDelete: Cascade)

  @@map("report_unlocks")
}

/**
 * Momentul lansării e-mailurilor de după înregistrare. Doar conturile și
 * contactele create după el le primesc — cele vechi n-au văzut anunțul de la
 * înregistrare. Un singur rând (id = 1), pus de migrare.
 */
model EmailSettings {
  id                  Int      @id @default(1)
  lifecycleLaunchedAt DateTime @default(now()) @map("lifecycle_launched_at")

  @@map("email_settings")
}

/**
 * Vizitatorii fără cont care au cerut ghidul primei constelații pe e-mail,
 * cu acordul explicit bifat. `email` se păstrează cu litere mici.
 */
model Lead {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String?
  sourcePage     String?   @map("source_page")
  consentAt      DateTime  @map("consent_at")
  consentText    String    @map("consent_text")
  createdAt      DateTime  @default(now()) @map("created_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")

  emailLogs EmailLog[]

  @@map("leads")
}

/**
 * Fiecare e-mail din ciclul de viață, o dată. `dedupeKey` = „adresă:fel”,
 * unic: rezervarea dinaintea trimiterii împiedică dublurile; o trimitere
 * eșuată își pune cheia pe NULL, ca să poată fi reîncercată. Id-ul (uuid
 * aleator) e și cheia linkului de dezabonare.
 */
model EmailLog {
  id        String   @id @default(uuid())
  email     String
  userId    String?  @map("user_id")
  leadId    String?  @map("lead_id")
  kind      String
  dedupeKey String?  @unique @map("dedupe_key")
  sentAt    DateTime @default(now()) @map("sent_at")
  resendId  String?  @map("resend_id")
  error     String?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([email, sentAt(sort: Desc)])
  @@index([kind, sentAt(sort: Desc)])
  @@index([userId])
  @@map("email_log")
}

/** Adresele care nu mai primesc e-mailurile de mai sus. Rămân și după ștergerea contului. */
model EmailUnsubscribe {
  email          String   @id
  unsubscribedAt DateTime @default(now()) @map("unsubscribed_at")
  emailLogId     String?  @map("email_log_id")

  @@map("email_unsubscribes")
}
