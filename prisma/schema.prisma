generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  referralCode String   @unique @map("referral_code")
  referredById String?  @map("referred_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  referredBy User?  @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals  User[] @relation("Referrals")

  constellations SavedConstellation[]
  payments       Payment[]

  @@map("users")
}

model SavedConstellation {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  title         String
  boardConfig   Json     @map("board_config")
  questionnaire Json
  natalChart    Json?    @map("natal_chart")
  teaserText    String?  @map("teaser_text")
  fullReport    Json?    @map("full_report")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("saved_constellations")
}

model Payment {
  id                      String    @id @default(uuid())
  userId                  String    @map("user_id")
  constellationId         String    @map("constellation_id")
  stripeCheckoutSessionId String    @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String?   @map("stripe_payment_intent_id")
  amountCents             Int       @map("amount_cents")
  currency                String
  status                  String    @default("pending") // pending | paid | failed | refunded
  unlockedAt              DateTime? @map("unlocked_at")
  createdAt               DateTime  @default(now()) @map("created_at")

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  constellation SavedConstellation @relation(fields: [constellationId], references: [id], onDelete: Cascade)

  @@map("payments")
}
