# Copiază acest fișier în .env.local și completează valorile reale.
# .env.local NU trebuie urcat niciodată în git (e deja ignorat prin .gitignore-ul Next.js).

# --- Postgres propriu (local: docker-compose; producție: containerul de pe Hetzner) ---
DATABASE_URL=postgresql://constelatii:constelatii@localhost:5432/constelatii

# --- Anthropic (Claude) ---
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# --- Stripe (test mode la început: dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
