# Copiază acest fișier în .env.local și completează valorile reale.
# .env.local NU trebuie urcat niciodată în git (e deja ignorat prin .gitignore-ul Next.js).

# --- Postgres (container postgres-db partajat de pe Hetzner, DB dedicat "constelatii") ---
DATABASE_URL=postgresql://constelatii:PAROLA_TA@178.104.20.127:5432/constelatii

# --- Anthropic (Claude) ---
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# Org-level keys require the workspace header (anthropic-workspace-id)
ANTHROPIC_WORKSPACE_ID=

# --- Stripe (test mode la început: dashboard.stripe.com/test/apikeys) ---
# Prețurile pachetelor stau în tabelul "packs" (vezi prisma/migrations), nu
# aici — nu mai e nevoie de un Price ID preconfigurat în Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Auth (NextAuth) ---
# generat cu: openssl rand -base64 32
AUTH_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Oblio (facturi) ---
# Firma NU este plătitoare de TVA. Opțional: numele cotei TVA din Oblio de trimis pe factură
# (ex. cota de 0% a firmei). Gol = cota implicită a firmei, doar dacă e 0%, altfel se omite.
# OBLIO_VAT_NAME=

# --- TikTok Pixel (se încarcă doar cu acord pentru „Marketing / reclame”) ---
NEXT_PUBLIC_TIKTOK_PIXEL_ID=DATG4B3C77U0AVP512Q0

# --- TikTok Events API (server): CompletePayment după plată, doar cu acord pentru marketing (lib/tiktok-events.ts) ---
# Token: TikTok Events Manager -> pixel -> Settings -> Generate Access Token; fără el nu se trimite nimic
TIKTOK_EVENTS_TOKEN=
# opțional; implicit pixelul de mai sus
TIKTOK_PIXEL_ID=DATG4B3C77U0AVP512Q0
# doar cât testezi (Events Manager -> Test events); în producție gol
TIKTOK_TEST_EVENT_CODE=

# --- E-mailuri (Resend) ---
# Cheia de trimitere si expeditorul (domeniul constelatii.com verificat in Resend).
RESEND_API_KEY=
EMAIL_FROM=

# --- Cronul e-mailurilor de dupa inregistrare (POST /api/cron/emails, vezi DEPLOY.md) ---
# Sir aleator lung (openssl rand -hex 32); fara el (sau sub 16 caractere) ruta raspunde 401.
CRON_SECRET=
